{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],
    "paths": { "@game/*": ["./script/game/*"], "@app/*": ["./script/app/*"], "@dev/*": ["./script/dev/*"] }
  },
  "include": ["script", "tools", "server"],
  "exclude": ["tools/analysis"]
}
